# Copy to ".env" next to play-api.ts (or point PLAY_ENV_FILE at it). The real .env is git-ignored.
# Values here only fill variables that are not already set in the environment.

# One Play API credential source:
# PLAY_SERVICE_ACCOUNT_KEY_FILE=/secure/path/play-service-account.json
# PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
# (or put the key file next to play-api.ts as service-account.json)
